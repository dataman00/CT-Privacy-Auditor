{
  "manifest_version": 3,
  "name": "CT Privacy Compliance Auditor",
  "version": "1.5",
  "description": "Enforces GPC signals globally and audits CTDPA profiling violations with frequency counters. Released under the GPL-3.0 license.",
  "permissions": [
    "privacy",
    "storage",
    "declarativeNetRequest",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "gpc_rules",
      "enabled": true,
      "path": "rules.json"
    }]
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
	"default_icon": "icon128.png"
  }
}
